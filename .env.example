# Список дозволених клієнтських IP-адрес або підмереж (CIDR) через кому.
# Доступ без логіна/пароля дозволено ТІЛЬКИ цим адресам (решта отримує відмову).
# Приклад декількох адрес: ALLOWED_IPS=185.112.41.130,203.0.113.10,10.8.0.0/24
ALLOWED_IPS=185.112.41.130

# Зовнішній порт, на якому слухає HTTP/HTTPS проксі
PROXY_PORT=8888

# Інтерфейс для прослуховування вхідних з'єднань
PROXY_BIND_IP=0.0.0.0

# Зовнішній вихідний IP сервера (залиште порожнім для IP за замовчуванням;
# корисно, якщо на сервері декілька мережевих інтерфейсів / додаткових IP)
OUTGOING_IP=

# Режим анонімності:
# false = звичайний прозорий HTTP/HTTPS проксі (за замовчуванням)
# true  = приховувати заголовки проксі (прапорець -a у 3proxy)
ANONYMOUS_MODE=false

# Обмеження цільових портів через кому (порожньо = дозволені всі порти, або напр. 80,443,8080,8443)
ALLOWED_TARGET_PORTS=

# Заборона звернень через проксі до localhost (127.0.0.0/8) та cloud metadata (169.254.169.254) самого сервера
BLOCK_LOCALHOST=true

# Максимальна кількість одночасних з'єднань
MAX_CONN=2000

# DNS-сервери через кому для швидкого асинхронного резолву та кешування
DNS_SERVERS=1.1.1.1,8.8.8.8

# Логування запитів у stdout (перегляд через docker compose logs -f)
ENABLE_LOGS=true
